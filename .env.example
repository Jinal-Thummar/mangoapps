# Copy this file to .env and fill in real values:  cp .env.example .env
# NEVER commit the real .env file.

# development | production
APP_ENV=development

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# PostgreSQL connection (either set DATABASE_URL, or the DB_* variables below)
# DATABASE_URL=postgresql://taskflow:password@localhost:5432/taskflow
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=replace-with-your-db-password
DB_CONNECT_TIMEOUT=5

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Set to true when served over HTTPS behind Nginx
SESSION_COOKIE_SECURE=false
